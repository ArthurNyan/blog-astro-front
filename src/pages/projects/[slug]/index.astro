---
import MainLayout from "@/layouts/main.astro";
import { ProjectService } from "@/shared/api/client";
import type { Project } from "@/shared/api/types";

export const getStaticPaths = async () => {
    const response = await ProjectService.getProjects({ populate: '*' });
    const projects = (response.data?.data || []) as Project[];

    return projects.map((project) => ({
        params: { slug: project.slug || '' },
        props: { projectId: project.documentId },
    }));
};

const { projectId } = Astro.props;

// Получаем полные данные проекта
const projectResponse = await ProjectService.getProjectById(projectId as string);
const project = projectResponse.data?.data as Project | undefined;
---

<MainLayout
    content={{ title: project?.name || 'Проект' }}
    className="flex flex-col gap-32"
>
    <article class="container mx-auto px-4 py-8 max-w-4xl">
        {project ? (
            <>
                <header class="mb-8">
                    <h1 class="text-4xl font-bold mb-4">{project.name}</h1>
                    
                    {project.description && (
                        <p class="text-xl text-gray-600 mb-4">{project.description}</p>
                    )}
                </header>

                {project.cover?.url && (
                    <img 
                        src={`http://localhost:1337${project.cover.url}`}
                        alt={project.name || ''}
                        class="w-full rounded-lg mb-8"
                    />
                )}

                <div class="prose prose-lg max-w-none mb-8">
                    {project.content}
                </div>

                {project.technologies && project.technologies.length > 0 && (
                    <div class="mb-8">
                        <h2 class="text-2xl font-semibold mb-4">Технологии</h2>
                        <div class="flex flex-wrap gap-2">
                            {project.technologies.map((tech) => (
                                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </div>
                )}

                <div class="flex gap-4">
                    {project.github_url && (
                        <a 
                            href={project.github_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="bg-gray-800 text-white px-6 py-2 rounded hover:bg-gray-700 transition-colors"
                        >
                            GitHub
                        </a>
                    )}
                    {project.live_url && (
                        <a 
                            href={project.live_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition-colors"
                        >
                            Live Demo
                        </a>
                    )}
                </div>
            </>
        ) : (
            <p class="text-center text-gray-600">Проект не найден</p>
        )}
    </article>
</MainLayout>


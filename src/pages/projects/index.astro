---
import MainLayout from "@/layouts/main.astro";
import { ProjectService } from "@/shared/api/client";
import type { Project } from "@/shared/api/types";

// Получаем проекты с популяцией всех связей
const projectsResponse = await ProjectService.getProjects({
    populate: '*',
    sort: 'createdAt:desc',
});

const projects = (projectsResponse.data || []) as Project[];
---

<MainLayout
    content={{ title: "Проекты - Портфолио" }}
    className="flex flex-col gap-32"
>
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-8">Мои проекты</h1>
        
        {projects.length === 0 ? (
            <p class="text-gray-600">Проектов пока нет</p>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {projects.map((project) => (
                    <article class="border rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                        {project.cover?.url && (
                            <img 
                                src={`http://localhost:1337${project.cover.url}`}
                                alt={project.name || ''}
                                class="w-full h-48 object-cover"
                            />
                        )}
                        <div class="p-6">
                            <h2 class="text-2xl font-semibold mb-2">
                                <a href={`/projects/${project.slug}`} class="hover:text-blue-600">
                                    {project.name}
                                </a>
                            </h2>
                            {project.description && (
                                <p class="text-gray-600 mb-4">{project.description}</p>
                            )}
                            {project.technologies && project.technologies.length > 0 && (
                                <div class="flex flex-wrap gap-2">
                                    {project.technologies.map((tech) => (
                                        <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        )}
    </div>
</MainLayout>

